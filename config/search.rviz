Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Frame Rate: 15
    Background Color: 28; 32; 40
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/PointCloud2
      Name: Measured depth
      Enabled: true
      Topic: {Value: /baseline/cloud_0, Reliability Policy: Reliable, Durability Policy: Volatile, Depth: 5}
      Size (m): 0.045
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 100; 160; 210
      Decay Time: 5
    - Class: rviz_default_plugins/Path
      Name: Estimated flight path
      Enabled: true
      Topic: {Value: /search/estimated_path, Reliability Policy: Reliable, Durability Policy: Volatile, Depth: 5}
      Color: 90; 230; 160
      Line Style: Billboards
      Line Width: 0.04
    - Class: rviz_default_plugins/Path
      Name: Authorized RACER path
      Enabled: true
      Topic: {Value: /search/authorized_path, Reliability Policy: Reliable, Durability Policy: Volatile, Depth: 5}
      Color: 245; 210; 80
      Line Style: Billboards
      Line Width: 0.035
    - Class: rviz_default_plugins/MarkerArray
      Name: Person candidates
      Enabled: true
      Topic: {Value: /search/targets, Reliability Policy: Reliable, Durability Policy: Volatile, Depth: 5}
    - Class: rviz_default_plugins/MarkerArray
      Name: Aircraft and labels
      Enabled: true
      Topic: {Value: /search/display, Reliability Policy: Reliable, Durability Policy: Volatile, Depth: 5}
    - Class: rviz_default_plugins/Image
      Name: Actual RGB
      Enabled: true
      Topic: {Value: /drone_0/rgb/image, Reliability Policy: Best Effort, Durability Policy: Volatile, Depth: 5}
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 11
      Focal Point: {X: 1.8, Y: 0, Z: 1.0}
      Pitch: 0.55
      Yaw: 0.85
      Target Frame: map
Window Geometry: {Width: 1280, Height: 850, X: 0, Y: 0}
